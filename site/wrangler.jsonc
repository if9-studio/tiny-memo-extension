// Tiny Memo pre-launch website: Cloudflare Workers static assets + canonical 301 entry (tiny-memo-web).
// Never run `wrangler deploy` directly; build output lives in dist/.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tiny-memo-web",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tiny-memo.if9.cool/*", "zone_name": "if9.cool" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
